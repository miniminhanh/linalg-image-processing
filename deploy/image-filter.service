# systemd service that keeps the filter UI running on a Linux server (e.g. Ubuntu on EC2).
# It starts on boot and restarts automatically if it crashes.
#
# Assumes the repo is at /home/ubuntu/linalg-image-processing with a virtual environment in .venv
# and runs as the default "ubuntu" user. Change User/WorkingDirectory/ExecStart if yours differ.
#
# Install:
#   sudo cp deploy/image-filter.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now image-filter
# Logs:
#   journalctl -u image-filter -f

[Unit]
Description=linalg image processing filter UI
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/linalg-image-processing
ExecStart=/home/ubuntu/linalg-image-processing/.venv/bin/python app.py

# Listen on all network interfaces on port 80, so the site is at http://<server-ip>/
Environment=HOST=0.0.0.0
Environment=PORT=80
Environment=MAX_SIDE=2000
# One image at a time: colour deblurring of a 2000 px image peaks around 300 MB,
# so this keeps a 1 GB instance safe. Other requests wait their turn.
Environment=MAX_JOBS=1
Environment=PYTHONUNBUFFERED=1

# Port 80 normally needs root; this lets the non-root user bind to it
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Restart if it crashes, and stop it from eating all of a small instance's memory
Restart=on-failure
RestartSec=3
MemoryMax=700M

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
